ASSISTANT_BFF_PORT=5008
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OpenAI-compatible 网关的思考参数格式。
# 可选值：openai / openrouter / zai / qwen / qwen-chat-template
# 例如内网网关如果要求 chat_template_kwargs.enable_thinking，就配置为 qwen-chat-template
OPENAI_COMPAT_THINKING_FORMAT=
FILE_BASE=/tmp
LOG_BASE=/tmp
ALLOW_ORIGINS=http://localhost:3000,https://example.com
GPTS_WHITE_LIST="jiangchi@qq.com;jiangchi007@qq.com"
PLATFORM_PORTAL_BASE_URL=http://localhost:5015/portal/api
PLATFORM_PORTAL_TOKEN=your_portal_token
PLATFORM_PORTAL_TIMEOUT_SECONDS=20
PLATFORM_TRUST_ENV=true
