ASSISTANT_BFF_PORT=5008

# OpenAI-compatible upstream
OPENAI_API_KEY=your_api_key_here
# Keep this aligned with the actual upstream gateway used by the deployment.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Registered assistant model names
ASSISTANT_MODEL_GLM47=glm-4.7
ASSISTANT_MODEL_QWEN35=qwen3.5-35b-a3b
ASSISTANT_MODEL_GLM5=glm-5

# Chat runtime fallback model names
MODEL_NAME_VL=qwen3.5-35b-a3b
MODEL_NAME_INSTRUCT=qwen3.5-35b-a3b
MODEL_NAME_THINKING=deepseek-r1-distill-qwen-32b
MODEL_NAME_QWQ=QwQ-32B
MODEL_NAME_DS=deepseek-r1-distill-qwen-32b

# Local runtime paths
FILE_BASE=/tmp
LOG_BASE=/tmp

# Business data storage
# Production: postgres
# Local fallback: sqlite
BUSINESS_STORAGE_BACKEND=postgres
POSTGRES_DSN=postgresql://username:password@127.0.0.1:5432/chatgemini
# Optional Postgres connection pool size. Keep conservative for small managed databases.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5
# Required when BUSINESS_STORAGE_BACKEND=postgres.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_HISTORY_ENCRYPTION_KEY=
# Shared by all BFF nodes to sign short-lived high-risk capability confirmations.
# If omitted, SESSION_HISTORY_ENCRYPTION_KEY is used; local development falls back to an ephemeral key.
AGENT_CONFIRMATION_SECRET=
# Optional when BUSINESS_STORAGE_BACKEND=postgres. If omitted, start.sh auto-fills it
# from the current machine's primary IP and writes it back into .env.
SQLITE_MIGRATION_NODE_ID=
# Session middleware secret for browser login sessions.
SESSION_SECRET=replace-with-a-secure-random-string
# Internal startup flag used by migrate_local_sqlite_to_postgres.py / start.sh.
ASSISTANT_BFF_SKIP_STARTUP_SQLITE_MIGRATION=0
# File retention window in days. Set to 0 to disable automatic expiry cleanup.
FILE_LIFETIME_DAYS=7

# Object storage
# Production: minio
# Local fallback: filesystem
OBJECT_STORAGE_BACKEND=minio
# Supports one or more host:port entries separated by commas or semicolons; failover follows the listed order.
MINIO_ENDPOINT=127.0.0.1:9000,127.0.0.2:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gptassistant
MINIO_REGION=
MINIO_BASE_PREFIX=assistant-files
MINIO_SECURE=false

# Optional feature flags
GPT_TRACE_ENABLED=false
GPTS_FEATURE_ENABLED=true
GPTS_WHITE_LIST=admin1@example.com,admin2@example.com
VOICE_LAB_WHITE_LIST=voice-admin@example.com
# Smart Office external-system defaults. Database feature flags take precedence after initialization.
EXTERNAL_ASSISTANT_FEATURE_ENABLED=false
EXTERNAL_ASSISTANT_WHITE_LIST=
EXTERNAL_ASSISTANT_TITLE=智能办公
# Initial Smart Office base URL. It seeds external_assistant_base_url on first startup;
# later changes should be made in the admin Product Configuration screen.
EXTERNAL_ASSISTANT_URL=
ALLOW_ORIGINS=http://localhost:3000,https://example.com

# External platform portal integration
PLATFORM_PORTAL_BASE_URL=http://localhost:5015/portal
PLATFORM_PORTAL_TOKEN=
PLATFORM_PORTAL_TIMEOUT_SECONDS=20
PLATFORM_TRUST_ENV=true

# Local telemetry / cache retention
USAGE_EVENT_RETENTION_DAYS=14
TRACE_RETENTION_DAYS=7
OBJECT_CACHE_RETENTION_DAYS=3
