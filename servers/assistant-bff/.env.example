ASSISTANT_BFF_PORT=5008

# OpenAI-compatible upstream
OPENAI_API_KEY=your_api_key_here
# Keep this aligned with the actual upstream gateway used by the deployment.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Registered assistant model names
ASSISTANT_MODEL_GLM47=glm-4.7
ASSISTANT_MODEL_QWEN35=qwen3.5-35b-a3b
ASSISTANT_MODEL_GLM5=glm-5

# Chat runtime fallback model names
MODEL_NAME_VL=qwen3.5-35b-a3b
MODEL_NAME_INSTRUCT=qwen3.5-35b-a3b
MODEL_NAME_THINKING=deepseek-r1-distill-qwen-32b
MODEL_NAME_QWQ=QwQ-32B
MODEL_NAME_DS=deepseek-r1-distill-qwen-32b

# Local runtime paths
FILE_BASE=/tmp
LOG_BASE=/tmp

# Business data storage
# Production: postgres
# Local fallback: sqlite
BUSINESS_STORAGE_BACKEND=postgres
POSTGRES_DSN=postgresql://username:password@127.0.0.1:5432/chatgemini
# Required when BUSINESS_STORAGE_BACKEND=postgres.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_HISTORY_ENCRYPTION_KEY=

# Object storage
# Production: minio
# Local fallback: filesystem
OBJECT_STORAGE_BACKEND=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gptassistant
MINIO_REGION=
MINIO_BASE_PREFIX=assistant-files
MINIO_SECURE=false

# Optional feature flags
GPT_TRACE_ENABLED=false
GPTS_FEATURE_ENABLED=true
GPTS_WHITE_LIST=admin1@example.com,admin2@example.com
VOICE_LAB_WHITE_LIST=voice-admin@example.com
ALLOW_ORIGINS=http://localhost:3000,https://example.com

# External platform portal integration
PLATFORM_PORTAL_BASE_URL=http://localhost:5015/portal
PLATFORM_PORTAL_TOKEN=
PLATFORM_PORTAL_TIMEOUT_SECONDS=20
PLATFORM_TRUST_ENV=true

# Local telemetry / cache retention
USAGE_EVENT_RETENTION_DAYS=14
TRACE_RETENTION_DAYS=7
OBJECT_CACHE_RETENTION_DAYS=3
