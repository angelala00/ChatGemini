ASSISTANT_METRICS_PORT=5010

# Assistant BFF upstream used to fetch dashboard data.
ASSISTANT_BFF_BASE_URL=http://localhost:5008
ASSISTANT_BFF_DASHBOARD_ENDPOINT=/api/metrics/dashboard
# Request timeout in seconds when fetching dashboard data from assistant-bff.
ASSISTANT_METRICS_TIMEOUT=5.0

# WebSocket push interval in seconds.
DASHBOARD_PUSH_INTERVAL=30
