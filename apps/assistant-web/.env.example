# MD5 形式站点访问密码，留空则为公开站点
# 默认值：<空>
REACT_APP_PASSCODE_MD5=
# 站点标题，会显示在浏览器标签页上
# 默认值：ChatGemini
REACT_APP_TITLE_SITE=
# 站点名称，会显示在页面头部
# 默认值：企业 AI 助手
REACT_APP_TITLE_HEADER=
# 助手名称，会显示在首页欢迎语中（例如：我是 XXX, 很高兴见到你！）
# 默认值：GPT助手
REACT_APP_ASSISTANT_NAME=
# Gemini API 密钥
# 默认值：<空>
REACT_APP_GEMINI_API_KEY=
# 逐字输出 Gemini 回应
# 默认值：true
REACT_APP_GEMINI_API_SSE=
# gptassistant 聊天接口版本，v1 使用旧 /api/chat，v2 使用新 /api/chat-v2
# 默认值：v2
REACT_APP_GPTASSISTANT_CHAT_API_VERSION=v2
# 是否显示 gptassistant 的可折叠思考块
# 默认值：true
REACT_APP_GPTASSISTANT_SHOW_THINKING=true
# 是否显示 gptassistant v2 的思考过程、附件工具调用和调试事件
# 默认值：false
REACT_APP_GPTASSISTANT_DEBUG_EVENTS=false
# 自定义 Gemini API 地址
# Default: <空>
REACT_APP_GEMINI_API_URL=
# 技术支持信息中的账号
# 默认值：abcc
REACT_APP_SUPPORT_CONTACT=
# 前端基路径（部署在子路径时使用，例如 /chat/）
# 默认值：/
VITE_BASE_PATH=
